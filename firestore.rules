rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'roshankedar122@gmail.com'
      );
    }

    // Validation for user document
    function isValidUser(data) {
      return data.id is string &&
        data.id.size() <= 128 &&
        data.role in ['pilgrim', 'vendor', 'admin'] &&
        data.name is string &&
        data.name.size() <= 100 &&
        data.language in ['en', 'hi', 'mr'] &&
        data.status in ['approved', 'pending_approval', 'rejected'];
    }

    match /users/{userId} {
      // Any authenticated user can read their own profile doc. Admins can read all.
      allow get: if isOwner(userId) || isAdmin();
      
      // Admins can list users. Normal users can only list their own document.
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);

      // Creation rules:
      // - Pilgrims: status must be 'approved', role must be 'pilgrim'
      // - Vendors: status must be 'pending_approval', role must be 'vendor'
      // - Admin accounts can only be written if user has admin claim
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data) && (
        (request.resource.data.role == 'pilgrim' && request.resource.data.status == 'approved') ||
        (request.resource.data.role == 'vendor' && request.resource.data.status == 'pending_approval') ||
        (request.resource.data.role == 'admin' && isAdmin())
      );

      // Update rules:
      // - User can update their own profile (name, language, elderlyOrDisabledMode, address, phone)
      //   BUT cannot change their role or upgrade their status to 'approved' if they are a vendor.
      // - Admins can update any field including status and role.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          isValidUser(request.resource.data) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.id == resource.data.id
        )
      );

      // Only admins can delete user documents
      allow delete: if isAdmin();
    }
  }
}
